//
// coderkrow dark — Telegram Desktop theme
// Built from .ai/rules/brand/RULES.md
//
// Palette: ground #111110 (never #000), surface #1a1a18,
// text #e8e6df (never #fff), muted #888780,
// teal #1a595a / #2e7f80 / #3bb8ba, signal cyan #00d1d4.
// No purple, no gradients, no shadows, flat surfaces only.
//
// Single-file theme: rename to .tdesktop-theme and import in
// Settings → Chat Settings → Theme → Create a new theme.
// See INSTALL.md for packaging with a background image.
//

// ---- base tokens -------------------------------------------------------
COLOR_BG:             #111110;   // near-black ground (not pure black)
COLOR_SURFACE:        #1a1a18;   // raised surface — cards, bubbles, menus
COLOR_SURFACE_HOVER:  #20201d;   // hover background
COLOR_SURFACE_ACTIVE: #2a2a26;   // pressed / ripple background
COLOR_SURFACE_MAX:    #33332e;   // deepest pressed step

COLOR_FG:             #e8e6df;   // warm off-white text
COLOR_FG_OVER:        #f5f4f0;   // brightest text
COLOR_FG_SOFT:        #b8b6ae;   // secondary / hovered subtext
COLOR_FG_SUBTLE:      #888780;   // muted metadata
COLOR_FG_DIM:         #6a6963;   // disabled

COLOR_TEAL:           #1a595a;   // brand teal
COLOR_TEAL_MID:       #2e7f80;   // interactive / hover
COLOR_TEAL_LIGHT:     #3bb8ba;   // links, badges, inline accents
COLOR_CYAN:           #00d1d4;   // signal — active states only

COLOR_BORDER:         #e8e6df12; // ink hairline (~7%)
COLOR_TEAL_TINT:      #1a595a14; // teal 8% — tinted surface
COLOR_TEAL_BORDER:    #1a595a33; // teal 20% — brand border

COLOR_RED:            #e2574c;   // errors / destructive (sparingly)
COLOR_GREEN:          #93c088;   // "good" text
COLOR_ORANGE:         #d9a35f;   // warning

